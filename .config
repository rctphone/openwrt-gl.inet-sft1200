CONFIG_TARGET_siflower=y
CONFIG_TARGET_siflower_sf19a2890=y
CONFIG_TARGET_siflower_sf19a2890_DEVICE_glinet_gl-sft1200=y
CONFIG_PACKAGE_luci-ssl=y

#
# Performance: interAptiv tuning, no MIPS16, -O2, LTO
# (kernel is already -O2 via generic CC_OPTIMIZE_FOR_PERFORMANCE)
#
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
# CONFIG_USE_MIPS16 is not set
CONFIG_USE_LTO=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mno-branch-likely -mips32r2 -mtune=interaptiv"

#
# WiFi (kmod-sf-wifi and kmod-sf-hnat come via DEVICE_PACKAGES)
#
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y

#
# Flow offloading (hardware NAT activation via fw4)
#
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
