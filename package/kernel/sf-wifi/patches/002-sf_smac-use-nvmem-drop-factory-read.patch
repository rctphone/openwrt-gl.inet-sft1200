+static int sf_wifi_read_nvmem(struct device *dev, const char *name, u8 **buf, size_t *len)
+{
+	struct nvmem_cell *cell;
+
+	cell = of_nvmem_cell_get(dev->of_node, name);
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	*buf = (u8 *)nvmem_cell_read(cell, len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(*buf))
+		return PTR_ERR(*buf);
+
+	return 0;
+}
+
+static int sf_wifi_rf_cali_config_get_nvmem(struct device *dev, u16 *value)
+{
+	struct nvmem_cell *cell;
+	const u8 *buf;
+	size_t len;
+	int ret = 0;
+
+	/* DT binding: nvmem-cell-names = "rf-cali-config" */
+	cell = of_nvmem_cell_get(dev->of_node, "rf-cali-config");
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	buf = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	if (len == 2) {
+		/* Match vendor behavior: raw bytes copied into u16 on LE. */
+		*value = buf[0] | (buf[1] << 8);
+		goto out;
+	}
+
+	if (len < 4) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Vendor format: 4 bytes with a marker then little-endian u16. */
+	if ((buf[0] == 'X' && buf[1] == 'O') ||
+	    (buf[0] == 'V' && (buf[1] == '2' || buf[1] == '3' || buf[1] == '4'))) {
+		*value = buf[2] | (buf[3] << 8);
+	} else {
+		ret = -EINVAL;
+	}
+
+out:
+	kfree(buf);
+	return ret;
+}
